# Convex — renseigné automatiquement par `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# URL publique du site (metadata, OG, sitemap, liens d'invitation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Version affichée dans Paramètres (optionnel)
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Console /admin -------------------------------------------------
# 1 = accessible, 0 ou absent = 404 (comportement par défaut en production).
ADMIN_ENABLED=1

# Mot de passe unique de la console. Obligatoire pour se connecter.
# Générer : openssl rand -base64 24
ADMIN_PASSWORD=

# Identifiant associé (optionnel, défaut : admin).
ADMIN_USERNAME=admin

# Clé de signature des sessions (HMAC-SHA256). Ne jamais changer sans
# invalider toutes les sessions ouvertes.
# Générer : openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Clé partagée avec le backend Convex pour les mutations d'administration
# (`npx convex env set ADMIN_KEY ...`).
ADMIN_KEY=
