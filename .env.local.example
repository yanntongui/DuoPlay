# Convex — renseigné automatiquement par `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# URL publique du site (metadata, OG, sitemap, liens d'invitation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Version affichée dans Paramètres (optionnel)
NEXT_PUBLIC_APP_VERSION=0.1.0

# Console /admin — maquette non authentifiée.
# Absent en production = 404. Mettre 1 uniquement quand l'auth réelle est branchée.
ADMIN_ENABLED=1
